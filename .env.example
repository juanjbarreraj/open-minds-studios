# Local backend configuration. Copy to .env and adjust if needed.
# None of these are secrets in local development, but SESSION_SECRET must be
# a strong random value in any shared or production environment.

# Express API port (the Vite dev server proxies /api requests here)
PORT=3001

# Cookie-signing secret for sessions
SESSION_SECRET=change-me-for-anything-beyond-local-dev

# Optional overrides
# DATABASE_PATH=/absolute/path/to/openminds.db
# UPLOADS_DIR=/absolute/path/to/uploads
# CORS_ORIGIN=http://localhost:5173

# Frontend: base URL for API calls. Defaults to /api (the Vite proxy locally).
# For a future hosted backend, set the full URL, e.g. https://api.example.com/api
# VITE_API_BASE_URL=/api
