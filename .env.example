# Local backend configuration. Copy to .env and adjust if needed.
# None of these are secrets in local development, but SESSION_SECRET must be
# a strong random value in any shared or production environment.

# Express API port (the Vite dev server proxies /api requests here)
PORT=3001

# Cookie-signing secret for sessions
SESSION_SECRET=change-me-for-anything-beyond-local-dev

# Optional overrides
# DATABASE_PATH=/absolute/path/to/openminds.db
# UPLOADS_DIR=/absolute/path/to/uploads

# Comma-separated list of browser origins allowed to send credentialed
# requests. Also the allowlist for the Origin check on state-changing calls.
# CORS_ORIGIN=http://localhost:5173

# Session cookie attributes. The defaults suit local HTTP through the Vite
# proxy. A frontend on GitHub Pages talking to a backend on another domain is
# a cross-site request and needs COOKIE_SAME_SITE=none with COOKIE_SECURE=true.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# When NODE_ENV=production the server refuses to start unless SESSION_SECRET
# is set to something other than the placeholders above, and cookies become
# Secure automatically.
# NODE_ENV=production

# Rate limits (in-memory, per process). Defaults are generous locally and
# stricter under NODE_ENV=production.
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_INQUIRY_WINDOW_MS=3600000
# RATE_LIMIT_INQUIRY_MAX=10

# Where local backups and data exports are written. Both directories are
# git-ignored; never commit a database, a backup, or an export.
# BACKUP_DIR=/absolute/path/to/backups
# EXPORT_DIR=/absolute/path/to/exports

# Frontend: base URL for API calls. Defaults to /api (the Vite proxy locally).
# For a future hosted backend, set the full URL, e.g. https://api.example.com/api
# VITE_API_BASE_URL=/api
